# systemd unit for the NEX server (same as the one running in production). Install: see deploy/README.md.
# Paths follow the layout used by deploy_server.py (--remote-root /opt/splatoon).
[Unit]
Description=Splatoon NEX server (matchmaking, NAT check)
After=network-online.target
Wants=network-online.target

[Service]
User=splatoon
Group=splatoon
WorkingDirectory=/opt/splatoon
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/splatoon/venv/bin/python /opt/splatoon/tools/nexlab/nexserver.py --config /opt/splatoon/server.json --log /var/log/splatoon/nexserver.log
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/splatoon /var/log/splatoon

[Install]
WantedBy=multi-user.target
